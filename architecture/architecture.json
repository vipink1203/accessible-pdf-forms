{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Accessible PDF forms: any PDF form becomes a guided interview",
    "output": "projects/accessible-pdf-forms/architecture/architecture.html",
    "locale": "en",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "external": {
          "label": "Person and form"
        },
        "cloud": {
          "label": "Meta's Muse model"
        },
        "backend": {
          "label": "Our code, no AI"
        },
        "security": {
          "label": "Safety check"
        },
        "database": {
          "label": "Saved for this form"
        },
        "frontend": {
          "label": "What they use"
        }
      }
    },
    "views": [
      {
        "id": "find",
        "label": "1. Find where answers go",
        "focus": [
          "form",
          "reader",
          "finder",
          "snap",
          "positions"
        ],
        "note": "A fillable form's own fields are read by our code. On a flat form, Muse finds each blank and our code lines it up."
      },
      {
        "id": "write",
        "label": "2. Muse writes the questions",
        "focus": [
          "form",
          "reader",
          "finder",
          "writer",
          "checker",
          "script"
        ],
        "note": "Muse writes plain questions from the form, seeing each field marked. Every quote must match the form word for word."
      },
      {
        "id": "answer",
        "label": "3. The person answers",
        "focus": [
          "person",
          "page",
          "script"
        ],
        "note": "One question at a time, by voice or by screen reader. Questions that don't apply are skipped; every answer is checked at the end."
      },
      {
        "id": "fill",
        "label": "4. Answers go onto the form",
        "focus": [
          "page",
          "filler",
          "positions",
          "filled"
        ],
        "note": "The answers are written onto the original page at the exact spots, one digit per box, on the person's own computer."
      },
      {
        "id": "talk",
        "label": "5. Or they just talk",
        "focus": [
          "person",
          "page",
          "hearer"
        ],
        "note": "The page reads each question aloud. Muse hears the reply; the page reads it back and moves on after a yes."
      }
    ]
  },
