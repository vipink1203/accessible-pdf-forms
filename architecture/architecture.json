  "cards": [
    {
      "dot": "cyan",
      "title": "What leaves the computer",
      "items": [
        "The blank public form, to Muse once per form and language",
        "Spoken replies, to Meta to be understood; not used for training",
        "Typed answers never leave"
      ]
    },
    {
      "dot": "emerald",
      "title": "Proven so far",
      "items": [
        "IRS W-9: 23 of 23 blanks found and placed, every quote word for word",
        "Voice runs pass in English and Spanish, with pause and resume",
        "Upload: W-9 and W-4 (fillable), and the W-4 made flat, filled correctly",
        "12 real accents heard with about 4% word errors"
      ]
    },
    {
      "dot": "rose",
      "title": "Not yet proven",
      "items": [
        "Scanned forms, and real flat forms beyond the W-4",
        "A real microphone in a noisy room",
        "Testing with blind users"
      ]
    }
